# ============================================================
#  Comprobacion de estado del backend.
#  Se usa la ruta de listado de usuarios porque responde siempre
#  con un documento JSON valido, incluso con la base vacia.
# ============================================================
option_settings:

  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /usuarios/listar

  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
