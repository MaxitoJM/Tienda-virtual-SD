# ============================================================
#  Elastic Beanstalk - Aplicacion de backend (plataforma Java SE)
#
#  Elastic Beanstalk enruta el trafico del balanceador hacia el
#  puerto 5000 de la instancia, por lo que la aplicacion debe
#  escuchar en ese puerto.
# ============================================================
option_settings:

  aws:elasticbeanstalk:application:environment:
    SERVER_PORT: "5000"
    DB_PORT: "3306"
    DB_NAME: "tiendagenerica"
    # Los valores de DB_HOST, DB_USER y DB_PASSWORD se definen en la
    # consola de Elastic Beanstalk: Configuracion -> Software ->
    # Propiedades del entorno. No se versionan credenciales.

  aws:elasticbeanstalk:container:java:staticfiles:
    /public: public

  aws:autoscaling:launchconfiguration:
    InstanceType: t2.micro

  aws:elasticbeanstalk:environment:
    EnvironmentType: SingleInstance
