# ============================================================
#  Elastic Beanstalk - Aplicacion de frontend (plataforma Tomcat)
#
#  El archivo WAR se despliega en Tomcat. La direccion del backend
#  se resuelve por la variable de entorno BACKEND_URL, de modo que
#  cambiar de entorno no exige recompilar la aplicacion.
# ============================================================
option_settings:

  aws:elasticbeanstalk:application:environment:
    # Reemplazar por la direccion del entorno de backend, por ejemplo:
    # http://equipoXpruebasbackend-env.us-east-2.elasticbeanstalk.com
    BACKEND_URL: "http://localhost:5000"

  aws:autoscaling:launchconfiguration:
    InstanceType: t2.micro

  aws:elasticbeanstalk:environment:
    EnvironmentType: SingleInstance

  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /ciclo3demo/inicio.jsp
