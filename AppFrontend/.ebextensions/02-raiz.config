# ============================================================
#  Redirige la raiz del sitio a la pagina de ingreso, de manera
#  que la direccion del entorno abra directamente la aplicacion
#  en lugar del error 404 propio de Tomcat.
# ============================================================
files:
  "/var/app/current/ROOT/index.jsp":
    mode: "000644"
    owner: webapp
    group: webapp
    content: |
      <% response.sendRedirect(request.getContextPath() + "/ciclo3demo/inicio.jsp"); %>
